# Build context for both deploy/docker/Dockerfile* is the repository root.
# Keep it to what the two images need: the Python libs and server wrapper
# for the MCP image, the web workspace for the web image.
*
!package.json
!package-lock.json
!packages/data-adapters/
!packages/mcp-core/
!packages/hf-space/
!packages/web/
!deploy/docker/nginx.conf
**/node_modules/
**/dist/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/tests/
**/*.pyc
packages/hf-space/uv.lock
packages/hf-space/pyproject.toml
packages/hf-space/.ruff.toml
packages/hf-space/Dockerfile
packages/hf-space/fetch_atlases.py
packages/web/scripts/
packages/web/test-results/
