# syntax=docker/dockerfile:1.7
#
# Static bundle of the OhMyWind web app behind nginx, for deployments that do
# not use Cloudflare Pages. The backend URL is compiled into the bundle by
# Vite, so it is a build argument, not a runtime setting: one image per
# backend. Build from the repository root:
#
#   docker build -f deploy/docker/Dockerfile.web \
#     --build-arg VITE_API_BASE=https://mcp.example.org -t ohmywind-web .
#
# Without the argument the bundle falls back to the upstream production
# server (packages/web/src/api/config.ts), which is almost never what a
# self-hosted deployment wants.

# ---------------------------------------------------------------- builder
# Pinned to amd64 whatever the target: the bundle is platform-independent,
# and package-lock.json only carries rolldown's linux-x64 native bindings
# (npm's optional-dependency handling records the platform the lock was
# generated on). Native on the CI runners; emulated on an arm64 laptop, which
# is slower but works. Building the bundle once also keeps the multi-arch
# publish from running Vite twice.
FROM --platform=linux/amd64 node:22-bookworm-slim AS builder

WORKDIR /src
# npm workspaces hoist to the repository root, so the install happens there.
COPY package.json package-lock.json ./
COPY packages/web/package.json packages/web/package.json
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund

COPY packages/web packages/web
ARG VITE_API_BASE
ENV VITE_API_BASE=${VITE_API_BASE}
RUN npm run build --workspace packages/web \
 # Cloudflare Pages control files: nginx.conf carries their rules instead.
 && rm -f packages/web/dist/_headers packages/web/dist/_redirects

# ---------------------------------------------------------------- runtime
FROM nginxinc/nginx-unprivileged:1.27-alpine

ARG VERSION=dev
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="ohmywind-web" \
      org.opencontainers.image.description="OhMyWind web app (static bundle, nginx)" \
      org.opencontainers.image.source="https://github.com/qdonnars/ohmywind" \
      org.opencontainers.image.url="https://ohmywind.fr" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}"

COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /src/packages/web/dist /usr/share/nginx/html

# nginx-unprivileged already runs as uid 101 on port 8080.
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
